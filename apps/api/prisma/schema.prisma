generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  role      String   @default("STUDENT") // STUDENT, MENTOR, ADMIN, SUPER_ADMIN
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  profile   Profile?
}

model Profile {
  id              String       @id @default(uuid())
  userId          String       @unique
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  phone           String?
  location        String?
  targetRole      String?
  readinessScore  Float?
  
  education       Education[]
  skills          StudentSkill[]
  projects        Project[]
  experiences     Experience[]
  certifications  Certification[]
  attempts        Attempt[]
  
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
}

model Education {
  id             String   @id @default(uuid())
  profileId      String
  profile        Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  degree         String
  university     String
  cgpa           Float
  graduationYear Int
}

model Skill {
  id          String   @id @default(uuid())
  name        String   @unique
  category    String   // e.g., TECHNICAL, APTITUDE, COMMUNICATION
  students    StudentSkill[]
}

model StudentSkill {
  id          String   @id @default(uuid())
  profileId   String
  skillId     String
  level       String   // e.g., BEGINNER, INTERMEDIATE, ADVANCED
  profile     Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  skill       Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([profileId, skillId])
}

model Project {
  id           String   @id @default(uuid())
  profileId    String
  profile      Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  name         String
  description  String
  technologies String   // Comma separated
  githubUrl    String?
  liveUrl      String?
}

model Experience {
  id             String   @id @default(uuid())
  profileId      String
  profile        Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  organization   String
  role           String
  duration       String
  responsibilities String
}

model Certification {
  id          String   @id @default(uuid())
  profileId   String
  profile     Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  name        String
  provider    String
  date        String
}

// ============================================
// Phase 4: Assessment Engine Models
// ============================================

model Assessment {
  id          String   @id @default(uuid())
  title       String
  description String
  category    String   // TECHNICAL, APTITUDE, COMMUNICATION
  difficulty  String   // EASY, MEDIUM, HARD
  timeLimit   Int      // In minutes
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  questions   AssessmentQuestion[]
  attempts    Attempt[]
}

model Question {
  id            String   @id @default(uuid())
  text          String
  options       String   // JSON stringified array of options
  correctAnswer String
  topic         String
  difficulty    String   // EASY, MEDIUM, HARD
  skill         String   // e.g. "React", "SQL"
  explanation   String?
  marks         Int      @default(1)
  
  assessments   AssessmentQuestion[]
}

model AssessmentQuestion {
  assessmentId String
  questionId   String
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  question     Question   @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@id([assessmentId, questionId])
}

model Attempt {
  id           String   @id @default(uuid())
  profileId    String
  assessmentId String
  profile      Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  
  startTime    DateTime @default(now())
  endTime      DateTime?
  status       String   @default("IN_PROGRESS") // IN_PROGRESS, COMPLETED
  totalScore   Float?
  
  answers      Answer[]
}

model Answer {
  id            String   @id @default(uuid())
  attemptId     String
  questionId    String
  attempt       Attempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  selectedOption String?
  isCorrect     Boolean  @default(false)
  marksAwarded  Float    @default(0)
  
  @@unique([attemptId, questionId])
}
